{
  "name": "hearth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:directory && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:directory": "tsc -p worker/tsconfig.json",
    "directory:dev": "wrangler dev --config worker/wrangler.jsonc",
    "directory:migrate:local": "wrangler d1 migrations apply hearth-directory --local --config worker/wrangler.jsonc",
    "directory:ingest:hrsa": "node scripts/import-hrsa.mjs",
    "directory:ingest:zcta": "node scripts/import-zcta.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.1",
    "@fontsource/fraunces": "^5.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "csv-parse": "^7.0.1",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.114.0"
  }
}
